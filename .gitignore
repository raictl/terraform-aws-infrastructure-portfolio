
# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files containing local values or secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration and credentials
.terraformrc
terraform.rc

# Sensitive local environment files
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~

